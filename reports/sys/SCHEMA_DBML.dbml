// AI PT Manager - Schema Visualization for dbdiagram.io
// Generated from SCHEMA_SPECIFICATIONS.md
// Date: 2025-11-06
// How to use: Copy and paste this entire file to https://dbdiagram.io/d

//=============================================================================
// ENUMS
//=============================================================================

Enum UserTier {
  PREMIUM
  STANDARD
  TRIAL
}

Enum TaskStatus {
  pending
  running
  completed
  failed
  skipped
}

Enum Priority {
  high
  medium
  low
}

Enum AgentType {
  frontdesk
  assessor
  program_designer
  manager
  marketing
  owner_assistant
  trainer_education
}

Enum OutputFormat {
  chat
  report
  graph
}

Enum ApprovalStatus {
  pending
  approved
  rejected
}

Enum InquiryType {
  membership
  trial
  question
}

Enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
  completed
}

//=============================================================================
// CORE SCHEMAS
//=============================================================================

Table OctostratorState {
  // User Input
  session_id varchar [pk, note: '세션 ID (UUID) = LangGraph thread_id']
  user_query varchar [not null, note: '사용자 질의']
  output_format OutputFormat [default: 'chat', note: '출력 형식']

  // Current State
  plan json [note: 'Cognitive Layer 계획']
  todos json [note: 'Todo 목록 (merge_todos_smart reducer)']
  execution_results json [note: 'Execute Layer 결과']
  final_response text [note: 'Response Layer 최종 응답']

  // Flags
  plan_valid boolean [default: false, note: '계획 유효성']
  requires_approval boolean [default: false, note: 'HITL 승인 필요']
  error text [note: '에러 메시지']

  // Conditional Flow Flags
  plan_requires_todos boolean [default: false]
  user_requested_todo_update boolean [default: false]
  need_todo_update boolean [default: false]

  // History Tracking
  action_history json [note: '액션 히스토리 (add_with_timestamp_and_step)']
  plan_history json [note: '계획 변경 히스토리 (track_plan_changes)']
  user_interactions json [note: '사용자 상호작용 (track_user_interactions)']

  // Metadata
  created_at timestamp [default: `now()`, note: '생성 시각']
  updated_at timestamp [default: `now()`, note: '업데이트 시각']
  total_steps int [default: 0, note: '총 실행 스텝 수']

  Note: 'Phase 3: State/Context 분리 완료. LLM/Context 필드 제거됨.'
}

Table AppContext {
  // User Information
  user_id varchar [pk, not null, note: '사용자 ID']
  session_id varchar [not null, note: '세션 ID']

  // User Tier
  user_tier UserTier [default: 'STANDARD', note: '사용자 등급']

  // Debug & Monitoring
  debug boolean [default: false, note: '디버그 모드']
  trace_id varchar [note: '분산 추적 ID (UUID)']
  log_level varchar [default: 'INFO', note: '로그 레벨']
  metrics json [note: '성능 메트릭']

  // Database (Phase 5)
  db_conn varchar [note: 'DB 연결 문자열']

  Note: 'Phase 3: Runtime Context (LangGraph 1.0+ Context API). 직렬화되지 않음.'
}

Table LLMSettings {
  context_id varchar [pk]

  // Model Selection
  default_model varchar [default: 'gpt-4o-mini', note: '기본 모델']

  // Intent Node
  intent_temperature decimal [default: 0.7, note: '0.0~2.0']
  intent_max_tokens int [default: 1024, note: '1~16384']
  intent_model varchar [default: 'gpt-4o-mini']

  // Planning Node
  planning_temperature decimal [default: 0.3]
  planning_max_tokens int [default: 2048]
  planning_model varchar [default: 'gpt-4o-mini']

  // Aggregator Node
  aggregator_temperature decimal [default: 0.5]
  aggregator_max_tokens int [default: 3072]
  aggregator_model varchar [default: 'gpt-4o-mini']

  // Chat Generator Node
  chat_temperature decimal [default: 0.7]
  chat_max_tokens int [default: 4096]
  chat_model varchar [default: 'gpt-4o-mini']

  // Graph Generator Node
  graph_temperature decimal [default: 0.2]
  graph_max_tokens int [default: 2048]
  graph_model varchar [default: 'gpt-4o-mini']

  // Report Generator Node
  report_temperature decimal [default: 0.5]
  report_max_tokens int [default: 8192]
  report_model varchar [default: 'gpt-4o-mini']

  // Agent Nodes
  agent_temperature decimal [default: 0.5]
  agent_max_tokens int [default: 4096]
  agent_model varchar [default: 'gpt-4o-mini']

  Note: 'Pydantic BaseModel. UserTier별 Preset 제공 (PREMIUM/STANDARD/TRIAL)'
}

//=============================================================================
// INFRASTRUCTURE TABLES
//=============================================================================

Table checkpoints {
  thread_id varchar [not null, note: 'LangGraph thread_id (= session_id in OctostratorState)']
  checkpoint_ns varchar [not null, default: '', note: 'Checkpoint namespace (기본값: "")']
  checkpoint_id varchar [not null, note: 'Checkpoint ID (UUID)']
  parent_checkpoint_id varchar [note: '부모 Checkpoint ID']
  checkpoint bytea [not null, note: 'msgpack serialized OctostratorState']
  metadata jsonb [note: 'Checkpoint metadata (source, step, writes 등)']

  indexes {
    (thread_id, checkpoint_ns, checkpoint_id) [pk]
    thread_id [name: 'idx_thread_id']
  }

  Note: 'LangGraph AsyncPostgresSaver table. Auto-created by checkpointer.setup()'
}

Table checkpoint_writes {
  thread_id varchar [not null]
  checkpoint_ns varchar [not null, default: '']
  checkpoint_id varchar [not null]
  task_id varchar [not null, note: 'Task ID (UUID)']
  idx int [not null, note: 'Write order index']
  channel varchar [not null, note: 'State channel name']
  type varchar [note: 'Write type']
  value bytea [note: 'msgpack serialized value']

  indexes {
    (thread_id, checkpoint_ns, checkpoint_id, task_id, idx) [pk]
    (thread_id, checkpoint_ns, checkpoint_id) [name: 'idx_checkpoint_writes']
  }

  Note: 'LangGraph checkpoint writes. Auto-created by checkpointer.setup()'
}

//=============================================================================
// SUPERVISOR STATES (4 Layers)
//=============================================================================

Table CognitiveState {
  cognitive_id varchar [pk]
  session_id varchar [not null]

  // Intent Understanding
  user_query varchar [not null]
  user_intent varchar [note: 'member_assessment, program_design 등']
  intent_confidence decimal [note: '0.0~1.0']
  intent_keywords json [note: '핵심 키워드 배열']

  // Planning
  plan json
  plan_goal varchar
  plan_steps json
  plan_version int [default: 1]
  is_planning boolean [default: false]

  // Validation
  plan_valid boolean [default: false]
  validation_result json
  validation_errors json
  validation_warnings json

  // Context and Memory
  user_context json
  historical_context json
  domain_context json

  // Analysis
  required_agents json [note: 'Agent 이름 배열']
  required_capabilities json
  estimated_duration decimal [note: '예상 소요 시간(초)']
  complexity_score decimal [note: '복잡도 0.0~1.0']

  // Alternative Plans
  alternative_plans json
  selected_plan_index int [default: 0]
  plan_selection_reason text

  Note: 'Layer 1: 의도 파악, 계획 수립, 검증'
}

Table TodoState {
  todo_state_id varchar [pk]
  session_id varchar [not null]

  // Todo Management
  todos json [note: 'Todo 항목 배열']
  active_todos json [note: '활성 Todo ID 배열']
  completed_todos json [note: '완료된 Todo ID 배열']
  failed_todos json [note: '실패한 Todo ID 배열']

  // Dependencies
  todo_dependencies json [note: 'Todo 의존성 그래프']
  blocked_todos json [note: '블로킹된 Todo ID 배열']

  // HITL (Human-in-the-Loop)
  requires_approval boolean [default: false]
  approval_status ApprovalStatus
  approval_feedback text

  // Metadata
  last_todo_update timestamp
  total_todos int [default: 0]
  progress_percentage decimal [default: 0, note: '0.0~100.0']

  Note: 'Layer 2: 작업 분해, 우선순위 설정, 의존성 관리'
}

Table ExecuteState {
  execute_state_id varchar [pk]
  session_id varchar [not null]

  // Execution Management
  todos json [note: '실행할 Todo 목록']
  execution_order json [note: '병렬 실행 그룹 배열']
  current_execution_group int [default: 0]
  is_executing boolean [default: false]

  // Task Status Tracking
  pending_tasks json
  running_tasks json
  completed_tasks json
  failed_tasks json
  skipped_tasks json

  // Execution Results
  execution_results json [note: '전체 결과']
  agent_results json [note: 'Agent별 결과']
  partial_results json [note: '중간 결과']

  // Error Handling
  execution_errors json
  error_recovery_attempts json
  max_retries int [default: 3]
  error_report json

  // Aggregation
  aggregated_data json
  aggregation_status varchar [default: 'pending', note: 'pending, processing, completed']
  insights json
  summary text

  // Performance Metrics
  execution_start_time timestamp
  execution_end_time timestamp
  task_timings json [note: 'Task별 실행 시간']
  total_execution_time decimal [note: '총 실행 시간(초)']

  // Agent Management
  active_agents json
  agent_availability json
  agent_workload json

  // Dependency Resolution
  dependency_graph json
  resolved_dependencies json
  blocked_tasks json

  // Resource Management
  resource_usage json
  resource_limits json
  resource_allocation json

  Note: 'Layer 3: Worker Agent 실행, 의존성 해결, 결과 집계'
}

Table ResponseState {
  response_state_id varchar [pk]
  session_id varchar [not null]

  // Input Data
  execution_results json [note: 'Execute Layer 결과']
  user_query varchar
  output_format OutputFormat [default: 'chat']

  // Response Generation
  generated_response text
  response_sections json [note: '응답 섹션 배열']
  response_metadata json

  // Formatting
  is_formatting boolean [default: false]
  format_options json

  // Quality Control
  response_quality_score decimal [note: '품질 점수 0.0~1.0']
  quality_issues json

  // Final Output
  final_response text [not null]

  Note: 'Layer 4: 최종 응답 생성 및 포매팅'
}

//=============================================================================
// WORKER AGENT STATES (7 Agents)
//=============================================================================

Table FrontdeskState {
  agent_id varchar [pk]
  session_id varchar [not null]

  // Base Agent Fields
  status TaskStatus [default: 'pending']
  result json
  error text
  started_at timestamp
  completed_at timestamp
  duration_seconds decimal

  // Lead Management
  lead_info json [note: 'LeadInfo 구조체']
  lead_list json [note: 'LeadInfo 배열']

  // Conversation
  inquiry_text text
  response_text text
  conversation_history json

  // Scoring
  lead_scoring_factors json
  recommended_action varchar [note: 'schedule_appointment, send_info, follow_up']

  // Appointment
  appointment_info json [note: 'AppointmentInfo 구조체']
  available_slots json

  // Notification
  notification_sent boolean [default: false]
  notification_recipients json

  // Analysis
  intent_classification varchar [note: '문의 의도 분류']
  urgency_level varchar [note: 'high, medium, low']
  estimated_conversion_rate decimal [note: '예상 전환율 0.0~1.0']

  Note: 'Worker Agent #1: 프론트데스크 응대, 리드 관리 (구현 완료 100%)'
}

Table AssessorState {
  agent_id varchar [pk]
  session_id varchar [not null]

  // Base Agent Fields
  status TaskStatus [default: 'pending']
  result json
  error text
  started_at timestamp
  completed_at timestamp
  duration_seconds decimal

  // Member Information
  member_id varchar
  member_name varchar
  assessment_date date

  // Inbody Data
  inbody_data json [note: '인바디 측정 결과']
  body_composition json [note: '체성분 분석']

  // Posture Analysis
  posture_images json [note: '자세 이미지 URL 배열']
  posture_analysis json [note: '자세 분석 결과']
  asymmetry_score decimal [note: '비대칭 점수']

  // Goals
  member_goals json [note: '회원 목표 배열']
  priority_goals json [note: '우선 목표 배열']

  // Assessment Results
  assessment_report json [note: '평가 보고서']
  risk_factors json [note: '위험 요소 배열']
  recommendations json [note: '권장 사항 배열']

  Note: 'Worker Agent #2: 회원 평가, 자세 분석 (구현 30%)'
}

Table ProgramDesignerState {
  agent_id varchar [pk]
  session_id varchar [not null]

  // Base Agent Fields
  status TaskStatus [default: 'pending']
  result json
  error text
  started_at timestamp
  completed_at timestamp
  duration_seconds decimal

  // Input Data
  member_id varchar
  assessment_results json [note: 'Assessor 결과']
  goals json [note: '목표 배열']

  // Program Design
  program_id varchar
  program_type varchar [note: 'strength, cardio, flexibility, mixed']
  duration_weeks int
  sessions_per_week int

  // Exercise Composition
  exercises json [note: '운동 목록']
  workout_phases json [note: '단계별 구성']
  progression_plan json [note: '진행 계획']

  // Program Output
  program_document json [note: '프로그램 문서']
  trainer_notes text [note: '트레이너 노트']

  Note: 'Worker Agent #3: 맞춤형 운동 프로그램 설계 (구현 30%)'
}

Table ManagerState {
  agent_id varchar [pk]
  session_id varchar [not null]

  // Base Agent Fields
  status TaskStatus [default: 'pending']
  result json
  error text
  started_at timestamp
  completed_at timestamp
  duration_seconds decimal

  // Manager specific fields (기본 구조)
  center_data json [note: '센터 운영 데이터']
  membership_data json [note: '회원권 관리 데이터']
  attendance_data json [note: '출석 데이터']
  revenue_analysis json [note: '매출 분석']

  Note: 'Worker Agent #4: 센터 관리 (구현 20%)'
}

Table MarketingState {
  agent_id varchar [pk]
  session_id varchar [not null]

  // Base Agent Fields
  status TaskStatus [default: 'pending']
  result json
  error text
  started_at timestamp
  completed_at timestamp
  duration_seconds decimal

  // Marketing specific fields (기본 구조)
  campaign_data json [note: '캠페인 데이터']
  sns_content json [note: 'SNS 콘텐츠']
  event_planning json [note: '이벤트 기획']

  Note: 'Worker Agent #5: 마케팅 (구현 10%)'
}

Table OwnerAssistantState {
  agent_id varchar [pk]
  session_id varchar [not null]

  // Base Agent Fields
  status TaskStatus [default: 'pending']
  result json
  error text
  started_at timestamp
  completed_at timestamp
  duration_seconds decimal

  // Owner Assistant specific fields (기본 구조)
  business_insights json [note: '비즈니스 인사이트']
  financial_analysis json [note: '재무 분석']
  decision_support json [note: '의사결정 지원']

  Note: 'Worker Agent #6: 원장 보조 (구현 10%)'
}

Table TrainerEducationState {
  agent_id varchar [pk]
  session_id varchar [not null]

  // Base Agent Fields
  status TaskStatus [default: 'pending']
  result json
  error text
  started_at timestamp
  completed_at timestamp
  duration_seconds decimal

  // Trainer Education specific fields (기본 구조)
  training_materials json [note: '교육 자료']
  trainer_feedback json [note: '트레이너 피드백']
  education_schedule json [note: '교육 일정']

  Note: 'Worker Agent #7: 트레이너 교육 (구현 10%)'
}

//=============================================================================
// SUB-STRUCTURES (Embedded JSON Types)
//=============================================================================

Table LeadInfo {
  lead_id varchar [pk]
  name varchar
  phone varchar
  email varchar
  inquiry_type InquiryType
  inquiry_content text [not null]
  lead_score decimal [note: '0.0~1.0']
  priority Priority
  source varchar [note: 'web, phone, sns']

  Note: 'FrontdeskState의 lead_info JSON 구조'
}

Table AppointmentInfo {
  appointment_id varchar [pk]
  lead_id varchar
  scheduled_date date
  scheduled_time time
  trainer_id varchar
  appointment_type varchar [note: 'consultation, trial, assessment']
  status AppointmentStatus
  notes text

  Note: 'FrontdeskState의 appointment_info JSON 구조'
}

Table TodoItem {
  id varchar [pk]
  title varchar [not null]
  description text
  agent_id AgentType
  status TaskStatus [default: 'pending']
  priority Priority [default: 'medium']
  dependencies json [note: '의존하는 Todo ID 배열']
  result json [note: '실행 결과 (완료 시)']
  error text [note: '에러 메시지 (실패 시)']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  Note: 'OctostratorState.todos 및 TodoState.todos의 항목 구조'
}

//=============================================================================
// RELATIONSHIPS
//=============================================================================

// Main State -> Supervisor States (1:1 via session_id)
Ref: OctostratorState.session_id < CognitiveState.session_id
Ref: OctostratorState.session_id < TodoState.session_id
Ref: OctostratorState.session_id < ExecuteState.session_id
Ref: OctostratorState.session_id < ResponseState.session_id

// Context -> Settings (1:1)
Ref: AppContext.user_id < LLMSettings.context_id

// Main State -> Infrastructure (1:N via session_id = thread_id)
// Note: session_id in OctostratorState maps to thread_id in LangGraph checkpoints
Ref: OctostratorState.session_id - checkpoints.thread_id
Ref: checkpoints.thread_id < checkpoint_writes.thread_id

// Main State -> Worker Agents (1:N via session_id)
Ref: OctostratorState.session_id < FrontdeskState.session_id
Ref: OctostratorState.session_id < AssessorState.session_id
Ref: OctostratorState.session_id < ProgramDesignerState.session_id
Ref: OctostratorState.session_id < ManagerState.session_id
Ref: OctostratorState.session_id < MarketingState.session_id
Ref: OctostratorState.session_id < OwnerAssistantState.session_id
Ref: OctostratorState.session_id < TrainerEducationState.session_id

// Frontdesk -> Appointment (1:N)
Ref: LeadInfo.lead_id < AppointmentInfo.lead_id

//=============================================================================
// TABLE GROUPS (for visualization)
//=============================================================================

TableGroup CoreSchemas {
  OctostratorState
  AppContext
  LLMSettings
}

TableGroup Infrastructure {
  checkpoints
  checkpoint_writes
}

TableGroup SupervisorStates {
  CognitiveState
  TodoState
  ExecuteState
  ResponseState
}

TableGroup WorkerAgents {
  FrontdeskState
  AssessorState
  ProgramDesignerState
  ManagerState
  MarketingState
  OwnerAssistantState
  TrainerEducationState
}

TableGroup SubStructures {
  LeadInfo
  AppointmentInfo
  TodoItem
}

//=============================================================================
// NOTES
//=============================================================================

Note CoreArchitecture {
  '''
  # AI PT Manager - Core Architecture

  ## Phase 3 Principles
  - **State**: 직렬화 가능한 비즈니스 데이터 (TypedDict)
  - **Context**: 불변 런타임 정보 (dataclass, LangGraph 1.0+ Context API)
  - **Config**: 시스템 전역 설정 (.env)

  ## 4-Layer Supervisor Pattern
  1. **Cognitive**: 의도 파악, 계획 수립
  2. **Todo**: 작업 분해, 의존성 관리
  3. **Execute**: Worker Agent 실행, 결과 집계
  4. **Response**: 최종 응답 생성

  ## UserTier System
  - **PREMIUM**: gpt-4o, 16K tokens
  - **STANDARD**: gpt-4o-mini, 8K tokens
  - **TRIAL**: gpt-4o-mini, 4K tokens

  ## Custom Reducers
  - merge_todos_smart: Todo 병합
  - add_with_timestamp_and_step: 히스토리 추적
  - track_plan_changes: 계획 변경 추적
  - track_user_interactions: 사용자 상호작용 추적

  ## Infrastructure
  - **session_id = thread_id**: OctostratorState의 session_id는 LangGraph AsyncPostgresSaver의 thread_id와 1:1 매핑
  - **checkpoints 테이블**: LangGraph가 자동 생성하는 PostgreSQL 테이블로 State를 msgpack으로 직렬화하여 저장
  - **checkpoint_writes 테이블**: Checkpoint 실행 중 각 노드의 write 작업을 기록
  '''
}
