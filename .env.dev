# Development Environment Variables (No Docker)

# Development Mode
USE_DEV_MODE=true

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# Database (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///octostrator.db

# Memory Store (In-memory for development)
REDIS_URL=memory://

# Security
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# LangSmith (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=octostrator-dev